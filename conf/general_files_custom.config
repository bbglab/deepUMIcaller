// This configuration file is used to define the general parameters for the pipeline when ran in IRBCluster
params {

    vep_species             = "<fill in with the species name: homo_sapiens, mus_musculus or your species of interest or comment the line>"
    vep_cache               = "<fill in with the path to the  Ensembl VEP cache or comment the line>"

    // Fasta references
    ref_fasta               = "<fill in with the path to the reference fasta file>"

    global_exons_file       = "<fill in with the path to the file or comment the line>"

    low_complex_file        = "<fill in with the path to the file or comment the line>"
    low_mappability_file    = "<fill in with the path to the file or comment the line>"
    nanoseq_snp_file        = "<fill in with the path to the file or comment the line>"
    nanoseq_noise_file      = "<fill in with the path to the file or comment the line>"

}


// Define the cacheDir for the singularity images
singularity.cacheDir    = '<fill in with the path to the singularity images cacheDir>'
singularity.libraryDir  = '<fill in with the path to the singularity images cacheDir>'
