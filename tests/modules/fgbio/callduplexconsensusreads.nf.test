nextflow_process {

    name "Test Process FGBIO_CALLDUPLEXCONSENSUSREADS"
    script "../../../modules/nf-core/fgbio/callduplexconsensusreads/main.nf"
    config "../nextflow.config"
    process "FGBIO_CALLDUPLEXCONSENSUSREADS"
    topics "versions"

    tag "modules"
    tag "fgbio"
    tag "callduplexconsensusreads"

    test("stub run emits consensus BAM") {
        tag "stub"

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 'B5'], file(params.module_testdata_base + '/B5.umi-grouped.bam', checkIfExists: true)]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.bam.size() == 1 },
                { assert process.out.bam[0][0].id == 'B5' },
                { assert file(process.out.bam[0][1]).name == 'B5.consensus.bam' },
                { assert topics.versions.size() == 1 }
            )
        }
    }

    // Real (non-stub) execution - see tests/test_data/modules/generate_real_fixtures.sh
    // (needs fgbio on PATH there to derive B5.grouped.bam)
    test("real run on B5 subset matches snapshot") {
        tag "real_data"
        config "../nextflow_real.config"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [[id: 'B5'], file(params.real_testdata_base + '/B5.grouped.bam', checkIfExists: true)]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
