nextflow_process {

    name "Test Process FGBIO_COLLECTDUPLEXSEQMETRICS"
    script "../../../modules/local/fgbio/collectduplexseqmetrics/main.nf"
    config "../nextflow.config"
    process "FGBIO_COLLECTDUPLEXSEQMETRICS"
    topics "versions"

    tag "modules"
    tag "fgbio"
    tag "collectduplexseqmetrics"

    test("stub run emits duplex metrics files") {
        tag "stub"

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 'B5'], file(params.module_testdata_base + '/B5.filtered.bam', checkIfExists: true)]
                input[1] = file(params.module_testdata_base + '/targets.interval_list', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.family_sizes.size() == 1 },
                { assert process.out.metrics.size() == 1 },
                { assert process.out.family_sizes[0][0].id == 'B5' },
                { assert file(process.out.family_sizes[0][1]).name.endsWith('duplex_family_sizes.txt') },
                { assert topics.versions.size() == 1 }
            )
        }
    }

    // Real (non-stub) execution - see tests/test_data/modules/generate_real_fixtures.sh
    // (needs fgbio on PATH there to derive B5.grouped.bam)
    test("real run on B5 subset matches snapshot") {
        tag "real_data"
        config "../nextflow_real.config"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [[id: 'B5'], file(params.real_testdata_base + '/B5.grouped.bam', checkIfExists: true)]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
