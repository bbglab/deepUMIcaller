nextflow_process {

    name "Test Process ASMINUSXS"
    script "../../../modules/local/filter_reads/asminusxs/main.nf"
    config "../nextflow.config"
    process "ASMINUSXS"
    topics "versions"

    tag "modules"
    tag "local"
    tag "asminusxs"

    test("stub run emits kept and discarded BAMs") {
        tag "stub"

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id: 'B5'],
                    file(params.module_testdata_base + '/B5.input1.bam', checkIfExists: true),
                    file(params.module_testdata_base + '/B5.input1.bam.bai', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.bam.size() == 1 },
                { assert process.out.discarded_bam.size() == 1 },
                { assert process.out.bam[0][0].id == 'B5' },
                { assert file(process.out.bam[0][1]).name == 'B5.filtered.AS-XS_10.bam' },
                { assert topics.versions.size() == 1 }
            )
        }
    }

    // Real (non-stub) execution - see tests/test_data/modules/generate_real_fixtures.sh
    test("real run on B5 subset matches snapshot") {
        tag "real_data"
        config "../nextflow_real.config"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [id: 'B5'],
                    file(params.real_testdata_base + '/B5.allmolecules.bam', checkIfExists: true),
                    file(params.real_testdata_base + '/B5.allmolecules.bam.csi', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
