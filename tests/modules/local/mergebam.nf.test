nextflow_process {

    name "Test Process MERGEBAM"
    script "../../../modules/local/mergebam/main.nf"
    config "../nextflow.config"
    process "MERGEBAM"
    tag "modules"
    tag "local"
    tag "mergebam"

    test("stub run emits merged BAM and BAI") {
        tag "stub"

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 'B5'], [
                    file(params.module_testdata_base + '/B5.input1.bam', checkIfExists: true),
                    file(params.module_testdata_base + '/B5.input2.bam', checkIfExists: true)
                ]]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.bam_bai.size() == 1 },
                { assert process.out.bam_bai[0][0].id == 'B5' },
                { assert file(process.out.bam_bai[0][1]).name == 'B5.merged.bam' },
                { assert file(process.out.bam_bai[0][2]).name == 'B5.merged.bam.bai' },
                { assert process.out.versions.size() == 1 }
            )
        }
    }

    // Real (non-stub) execution against a small real B5 subset - catches actual
    // tool-behaviour regressions (e.g. fgbio -> fgumi divergence upstream),
    // not just wiring. Requires fixtures generated with
    // tests/test_data/modules/generate_real_fixtures.sh
    test("real run on B5 subset parts matches snapshot") {
        tag "real_data"
        config "../nextflow_real.config"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [[id: 'B5'], [
                    file(params.real_testdata_base + '/B5.part1.bam', checkIfExists: true),
                    file(params.real_testdata_base + '/B5.part2.bam', checkIfExists: true)
                ]]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
