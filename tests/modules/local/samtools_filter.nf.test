nextflow_process {

    name "Test Process SAMTOOLS_FILTER"
    script "../../../modules/local/filter_reads/samtools/main.nf"
    config "../nextflow.config"
    process "SAMTOOLS_FILTER"
    topics "versions"
    tag "modules"
    tag "local"
    tag "samtools_filter"

    test("stub run emits CRAM output and versions") {
        tag "stub"

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 'B5'], file(params.module_testdata_base + '/B5.input1.bam', checkIfExists: true)]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.cram.size() == 1 },
                { assert process.out.cram[0][0].id == 'B5' },
                { assert file(process.out.cram[0][1]).name == 'B5.cram' },
                { assert topics.versions.size() == 1 }
            )
        }
    }

    // Real (non-stub) execution - see tests/test_data/modules/generate_real_fixtures.sh
    test("real run on B5 subset matches snapshot") {
        tag "real_data"
        config "../nextflow_real.config"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [[id: 'B5'], file(params.real_testdata_base + '/B5.allmolecules.bam', checkIfExists: true)]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
