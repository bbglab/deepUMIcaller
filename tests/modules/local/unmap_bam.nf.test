nextflow_process {

    name "Test Process UNMAP_BAM"
    script "../../../modules/local/unmap/main.nf"
    config "../nextflow.config"
    process "UNMAP_BAM"
    topics "versions"
    tag "modules"
    tag "local"
    tag "unmap_bam"

    test("stub run emits noPG BAM") {
        tag "stub"

        options "-stub"

        when {
            process {
                """
                input[0] = [[id: 'B5'], file(params.module_testdata_base + '/B5.input1.bam', checkIfExists: true)]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.bam.size() == 1 },
                { assert process.out.bam[0][0].id == 'B5' },
                { assert file(process.out.bam[0][1]).name == 'B5.queryname.noPG.bam' },
                { assert topics.versions.size() == 1 }
            )
        }
    }

    // Real (non-stub) execution - see tests/test_data/modules/generate_real_fixtures.sh
    test("real run on B5 subset matches snapshot") {
        tag "real_data"
        config "../nextflow_real.config"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [[id: 'B5'], file(params.real_testdata_base + '/B5.consensus.bam', checkIfExists: true)]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
