process {
  executor = 'local'
}

conda {
  enabled = false
}

docker {
  enabled = false
}

singularity {
  enabled = false
}

params {
  module_testdata_base = "${projectDir}/tests/test_data/modules/fgbio"
}

process {
  // Production resource labels (e.g. bam_processing_heavy = 50.GB) can exceed what's
  // available on a laptop/CI runner; cap resources for all module-level unit tests.
  cpus   = 1
  memory = '2.GB'
  time   = '10.m'

  // A bare `process {}` block (above) does NOT override resource labels set
  // via withLabel/withName in conf/base.config - selector-based directives
  // always win over generic ones, regardless of file load order (same issue
  // as tests/modules/nextflow_real.config). -stub tests still land on
  // whatever node is running nf-test (no real work happens, but Nextflow
  // still checks the process' requested resources against what's available),
  // so cap every module covered by these tests explicitly by name.
  withName: 'FGBIO_GROUPREADSBYUMI|FGBIO_CALLDUPLEXCONSENSUSREADS|FGBIO_COLLECTDUPLEXSEQMETRICS|FGBIO_FILTERCONSENSUSREADS|UNMAP_BAM|MERGEBAM|ASMINUSXS|SAMTOOLS_FILTER|CALLING_VARDICT_CHUNK|MERGE_VARDICT_RESULTS' {
    cpus   = 1
    memory = '2.GB'
    time   = '10.m'
  }
}

// Defensive: tests/nextflow.config (always loaded first by nf-test.config)
// points trace/timeline/report/dag at "${params.outdir}/...", which is never
// set for these isolated module tests unless injected via each test's
// when{ params { outdir = "$outputDir" } } block (see the .nf.test files) -
// file-level params here aren't visible yet when that earlier config file is
// parsed. Disable these regardless - irrelevant for a single-process unit test.
trace    { enabled = false }
timeline { enabled = false }
report   { enabled = false }
dag      { enabled = false }
