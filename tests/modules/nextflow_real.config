// Per-test config override (see `config` inside individual test() blocks) for
// the non-stub, real-execution module tests (tag "real_data"). Unlike
// tests/modules/nextflow.config (used for -stub tests), real fgbio/samtools/
// pysam containers must actually run here, so singularity is explicitly
// re-enabled regardless of the block-level config's `singularity.enabled = false`.
// cacheDir/autoMounts/runOptions are inherited from tests/nextflow.config,
// which nf-test.config always loads as a base for every test.
singularity {
  enabled = true
}

docker {
  enabled = false
}

conda {
  enabled = false
}

process {
  executor = 'local'
  cpus     = 1
  memory   = '2.GB'
  time     = '10.m'

  // A bare `process {}` block (above) does NOT override resource labels set
  // via withLabel/withName in conf/base.config (e.g. FGBIO_FILTERCONSENSUSREADS
  // asks for 20.GB, UNMAP_BAM for 8 cpus) - selector-based directives always
  // win over generic ones, regardless of file load order. These real_data
  // fixtures are tiny (a few thousand records), so cap each process
  // explicitly by name instead, matching whatever this host actually has.
  withName: 'FGBIO_GROUPREADSBYUMI|FGBIO_CALLDUPLEXCONSENSUSREADS|FGBIO_COLLECTDUPLEXSEQMETRICS|FGBIO_FILTERCONSENSUSREADS|UNMAP_BAM|MERGEBAM|ASMINUSXS|SAMTOOLS_FILTER' {
    cpus   = 1
    memory = '2.GB'
    time   = '10.m'
  }

  // FGBIO_FILTERCONSENSUSREADS requires ext.fgbio_args (in particular
  // --min-reads, which fgbio treats as mandatory with no default). In
  // production this only gets set for the FILTERCONSENSUSREADSAM /
  // FILTERCONSENSUSREADSDUPLEX *aliases* (conf/modules.config), which don't
  // match when testing the base process name directly - so supply the same
  // "AM" values here. Hardcoded (not `${params.filter_min_reads_am}` etc.) -
  // referencing params.* inside a withName block broke config parsing
  // entirely on Nextflow 24.10.4 ("Unknown config attribute"). Keep these in
  // sync with nextflow.config's filter_min_reads_am / filter_min_baseq_am /
  // filter_max_base_error_rate_am / maxN_prop_per_read defaults.
  withName: 'FGBIO_FILTERCONSENSUSREADS' {
    ext.fgbio_args = " --min-reads 2 1 0 --min-base-quality 20 --max-base-error-rate 0.1 0.1 0.1 --max-no-call-fraction 0.2 --require-single-strand-agreement false"
    // Needs the FULL reference genome loaded into memory (see reference.fa in
    // generate_real_fixtures.sh) - the module sets -Xmx to task.memory, and
    // 2.GB isn't enough to hold a ~3GB human genome FASTA (OutOfMemoryError).
    memory = '6.GB'
  }
}

params {
  real_testdata_base = "${projectDir}/tests/test_data/modules/real"
}

// tests/nextflow.config (always loaded as a base by nf-test.config) defines
// trace/timeline/report/dag file paths under "${params.outdir}/pipeline_info/...",
// but params.outdir is never set for these isolated module tests, causing
// "Unknown config attribute `params.outdir`". These artifacts are irrelevant
// for a single-process unit test, so just disable them.
trace    { enabled = false }
timeline { enabled = false }
report   { enabled = false }
dag      { enabled = false }
