// Optional debug config: force-publish the intermediate BAMs that
// generate_real_fixtures.sh needs, from a FRESH end-to-end run, instead of
// relying on the old reference run parked in fcalvet's scratch space.
//
// Usage (from the repo root, on a host with access to the real FASTQs):
//   nextflow run main.nf -profile test,singularity \
//       -c tests/nextflow.config -c tests/test_data/modules/publish_intermediates.config \
//       --input tests/test_data/input/input_test.csv \
//       --outdir /path/to/e2e_normal_out \
//       -work-dir /path/to/e2e_normal_work \
//       -resume
//
// Afterwards, point generate_real_fixtures.sh at it:
//   SRC_BASE=/path/to/e2e_normal_out/bams ./tests/test_data/modules/generate_real_fixtures.sh
//
// These 5 processes normally have `publishDir enabled: false` (see
// conf/modules.config) because their outputs are only intermediate - that's
// why they don't show up under --outdir on a normal run.
process {
    withName: 'SORTBAMRAWTEMPCOORDINATE' {
        publishDir = [
            enabled: true,
            path: { "${params.outdir}/bams/SORTBAMCLEAN" },
            mode: 'copy',
            pattern: '*{bam,csi}'
        ]
    }
    withName: 'CALLCONSENSUSREADS' {
        publishDir = [
            enabled: true,
            path: { "${params.outdir}/bams/CALLDUPLEXCONSENSUSREADS" },
            mode: 'copy',
            pattern: '*.bam'
        ]
    }
    withName: 'SORTBAMALLMOLECULES' {
        publishDir = [
            enabled: true,
            path: { "${params.outdir}/bams/SORTBAMALLMOLECULES" },
            mode: 'copy',
            pattern: '*{bam,csi}'
        ]
    }
    withName: 'SORTBAMAMFILTERED' {
        publishDir = [
            enabled: true,
            path: { "${params.outdir}/bams/SORTBAMAMFILTERED" },
            mode: 'copy',
            pattern: '*{bam,csi}'
        ]
    }
    withName: 'SORTBAMDUPLEXCONS' {
        publishDir = [
            enabled: true,
            path: { "${params.outdir}/bams/SORTBAMDUPLEXCONS" },
            mode: 'copy',
            pattern: '*{bam,csi}'
        ]
    }
}
